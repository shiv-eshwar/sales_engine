APP_BASE_URL=http://127.0.0.1:5173
PORT=3000

# Generate with: npm run hash-password -- "your-password"
APP_PASSWORD_HASH=scrypt$replace_salt$replace_hash
SESSION_SECRET=replace-with-at-least-32-characters-of-random

DATABASE_PATH=./data/ledger.sqlite
SHEETS_CONFIG_PATH=./config/sheets.example.yaml
CAMPAIGNS_DIR=./config/campaigns
PLAYBOOK_PATH=./config/playbooks/cold-calling.yaml

# memory = local fixture (no Google). google = live Sheets. none = unconfigured.
SHEETS_BACKEND=memory

GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_ID=
TWILIO_ALLOWED_COUNTRIES=US,CA

RECORDING_NOTICE=Recording and transcription may be active. Give any required notice before substantive conversation. This app does not guarantee legal compliance.

DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en
# inbound → caller, outbound → contact until a live smoke test confirms the mapping.
TWILIO_TRACK_CALLER=inbound
TWILIO_TRACK_CONTACT=outbound

LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_API_MODE=chat_completions
# npm run proxy:setup configures the local ChatGPT subscription proxy and Responses mode.
# SALES_LITELLM_PORT=4001
# SALES_LITELLM_MASTER_KEY is generated by proxy:setup; never commit it.

# Campaign and prospect preparation have a longer budget than live coaching.
AI_GENERATION_TIMEOUT_MS=90000
RESEARCH_TIMEOUT_MS=60000
# With api.openai.com, research reuses the LLM connection through Responses web_search.
# For a different Responses-compatible research provider, set all three explicitly:
# RESEARCH_BASE_URL=https://api.openai.com/v1
# RESEARCH_API_KEY=...
# RESEARCH_MODEL=...

NODE_ENV=development
